{
  "name": "siati",
  "version": "1.0.0",
  "private": true,
  "description": "Sistem Informasi Absensi dan Cuti Karyawan",
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "dev:client": "npm run dev -w client",
    "dev:server": "npm run dev -w server",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "db:migrate": "npm run migrate -w server",
    "db:migrate:rollback": "npm run migrate:rollback -w server",
    "db:seed": "npm run seed -w server",
    "db:reset": "npm run db:reset -w server",
    "lint": "concurrently \"npm run lint -w client\" \"npm run lint -w server\""
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
